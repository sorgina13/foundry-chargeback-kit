# Copy to .env and fill in. Never commit .env.

# --- Gateway (APIM) ---
APIM_BASE=https://<your-apim>.azure-api.net/<api-path>
APIM_SUBSCRIPTION_KEY=
AGENT_ID=<hosted-agent-id>
AGENT_ROUTE=<agent-route-segment>
FOUNDRY_API_VERSION=2025-05-01

# --- Telemetry ---
# Application Insights > API Access > Application ID.
# Not the resource name, instrumentation key, or connection string.
APPLICATIONINSIGHTS_APP_ID=
TELEMETRY_LOOKBACK_HOURS=2
TELEMETRY_INGESTION_TIMEOUT_SECONDS=180
TELEMETRY_POLL_SECONDS=10

# --- Prototype defaults ---
E2E_COST_CENTRE=CC-1000

# --- Agent runtime (agent/, local execution only) ---
FOUNDRY_PROJECT_ENDPOINT=https://<your-account>.services.ai.azure.com/api/projects/<your-project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=<model-deployment-name>
# Set only when local spans should be exported. Foundry injects this in hosted deployments.
APPLICATIONINSIGHTS_CONNECTION_STRING=
